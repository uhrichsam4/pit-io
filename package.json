{
  "name": "pit-io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "server": "node server/server.js",
    "start": "node server/server.js",
    "voices": "node --env-file-if-exists=.env tools/generate-voices.mjs",
    "voices:dry": "node --env-file-if-exists=.env tools/generate-voices.mjs --dry-run",
    "audit:secrets": "node tools/audit-secrets.mjs"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
