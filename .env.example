# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env
#
# NOTHING in .env is ever bundled into the browser build. Vite only exposes
# variables prefixed with VITE_, and none of these are. The key is read
# server-side by tools/generate-voices.mjs and by the deployed server process.

# --- ElevenLabs -------------------------------------------------------------
# Used ONLY by `npm run voices` to generate the NPC voice lines ahead of time,
# and never during gameplay. The game ships the generated audio files; it never
# sees the key.
#
# Multiple keys are supported. The generator rolls to the next one when a key
# hits a 401 or a 429 quota error, and reports only WHICH SLOT it used — never
# the value.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=

# --- Server -----------------------------------------------------------------
PORT=8080
