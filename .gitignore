node_modules/
dist/
shots/
.DS_Store
*.log

# --- secrets. Nothing here ever reaches a commit or the browser bundle. -----
.env
.env.*
!.env.example
*.key
# Broad on purpose. The owner dropped a key file named
# "11 labs api keys for claude.env.txt" into the repo root, which matched NONE
# of the earlier patterns — `.env.*` only matches names STARTING with .env, and
# Finder had hidden the trailing .txt. One `git add -A` would have committed a
# live credential. These patterns catch it by extension AND by name.
*.env
*.env.txt
*api*key*
*API*KEY*
**/api*key*.txt
**/*api-keys*
secrets/
# NOTE: public/audio/voice/ is deliberately NOT ignored. It looked like a build
# artefact — generated, large, rebuildable — so it was ignored at first. But
# Render builds from git and `vite build` only copies public/ into dist/, so
# ignoring the source meant the deployed game would have shipped completely
# silent while working perfectly on this machine. It is 3.6 MB of committed
# asset; regenerating it needs an API key the deploy does not have.
samples/
